        { "speaker": "npc", "text": { "en": "He was once a pre-Sundering archmage. Now he is something far worse.", "ru": "Он был архимагом. Ныне он что-то хуже.", "ch": "" }, "emotion": "neutral" },
        { "speaker": "npc", "text": { "en": "Beware: he commands the dead, and the dead remember everything.", "ru": "Остерегайтесь.", "ch": "" }, "emotion": "surprised" }
